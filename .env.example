# Cynbit AI Concierge Environment Variables

# Choose either Google Gemini API or OpenAI API
# Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Server Port
PORT=3000
